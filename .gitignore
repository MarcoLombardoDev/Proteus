# Proteus - .gitignore

# PyInstaller
build/
dist/
*.spec
__pycache__/
*.pyc
*.pyo

# Application logs and local configuration
logs/
config/

# Virtual environments
.venv/
venv/
env/

# Tests
.pytest_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
.DS_Store

# Backup files produced by the tool
*.bak

# Icon generator preview output
app_preview.png
