# Rebranding Tool - .gitignore

# PyInstaller
build/
dist/
*.spec
__pycache__/
*.pyc
*.pyo

# Logs e configurazione locale dell'applicazione
logs/
config/

# Ambienti virtuali
.venv/
venv/
env/

# Test
.pytest_cache/
.coverage
htmlcov/

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
.DS_Store

# Backup file generati dal tool
*.bak
